{
  "name": "pinnacle-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:qa": "node --conditions=react-server --import tsx scripts/seed-qa-data.mts",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test src/tests/*.test.mts",
    "verify:workflow": "node --conditions=react-server --import tsx src/lib/workflows/verification/cli.mts",
    "verify:workflow:verbose": "node --conditions=react-server --import tsx src/lib/workflows/verification/cli.mts --verbose"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
